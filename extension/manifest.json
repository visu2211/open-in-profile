{
  "manifest_version": 3,
  "name": "Open Tab in Profile",
  "version": "1.0",
  "description": "Send the current tab, or all shift-selected tabs, to another Chrome profile or an Incognito window.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "contextMenus", "storage", "identity"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open tab in profile",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
